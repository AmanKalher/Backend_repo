# ============================================================
# DiagNect Environment Configuration (.env.example)
# ============================================================

# --- SERVER CONFIGURATION ---
PORT=4000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:5173

# --- FRONTEND CLIENT CONFIGURATION ---
VITE_API_BASE_URL=http://localhost:4000

# --- AI CLINICAL ENGINE CONFIGURATION ---
# AI Provider: 'mock' (default) | 'gemini' | 'openai'
AI_PROVIDER=mock

# Real AI API Keys (Used ONLY when AI_PROVIDER=gemini or AI_PROVIDER=openai)
# Keep these strictly on the backend! NEVER prefix with VITE_
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model Options
GEMINI_MODEL=gemini-1.5-flash
OPENAI_MODEL=gpt-4o-mini

# --- TESTING & RESILIENCE ---
# Set to 0.15 for 15% random upstream failure simulation during frontend resilience testing
SIMULATE_FAILURE_RATE=0

# --- RATE LIMITING ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
